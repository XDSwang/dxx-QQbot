# ============================================================
# run.py 的配置模板 —— 复制成同目录的 update.cfg 再填（update.cfg 不进 git）
# 服务端只需要跑一条命令：python run.py
# ============================================================

# 私有地址后端：github（推荐，私有仓库）/ local（本地目录；测试或内网挂载用）
UPDATER_BACKEND = github

# ---- github 后端 ----
# 必须是【私有仓库】；token 用 fine-grained PAT，只给这一个仓库的 Contents 读写权限。
# 只轮询不回写时给只读权限即可（把 UPDATER_PUSH_RUNTIME 设 0）。
UPDATER_GITHUB_REPO = 你的账号/私有仓库名
UPDATER_GITHUB_TOKEN = github_pat_xxxxxxxx
# 信号与数据文件放在仓库里的哪个目录；留空表示仓库根目录
UPDATER_GITHUB_PATH = bot-sync
UPDATER_GITHUB_BRANCH = main
# UPDATER_GITHUB_API = https://api.github.com

# ---- local 后端（UPDATER_BACKEND = local 时才生效）----
# 目录里放 run0 或 run1、config.txt、schema.json、runtime.json
UPDATER_LOCAL_DIR = remote

# ---- 更新行为 ----
# 轮询间隔（秒）。用户要求 10 秒；同一域名连续访问仍会过 3.5 秒节流闸。
UPDATER_POLL_SECONDS = 10
# 检测到 run1 后先 git pull --ff-only；代码和配置必须同一版
UPDATER_GIT_PULL = 1
# 配置合并：structure = 按云端结构增删字段但保留服务端本地的值（默认，安全）
#            overwrite = 整份照抄云端（只有云端放的是含密钥的完整副本时才用）
UPDATER_CONFIG_MERGE = structure
# 迁移完成后把「最新完整 + 旧数据迁移」的结果回写私有地址的 runtime.json
UPDATER_PUSH_RUNTIME = 1
# 机器人入口（相对项目根）
UPDATER_BOT_ENTRY = python/qq_bot.py

# ============================================================
# 私有地址（或本地 UPDATER_LOCAL_DIR）里的四个文件
# ------------------------------------------------------------
# run0 / run1     信号文件：改文件名为 run1 = 需要更新，run0 = 不需要。
#                 也支持 run2、run3… 递增版本号；服务端按「文件名 + 指纹」去重，
#                 云端不复位 run0 也不会每 10 秒重跑一次。
# config.txt      机器人配置（建议放全字段模板；服务端本地密钥 / 白名单 / 路径值会保留）
# schema.json     最新字段结构 + 改名规则，用户维护、服务端只读。示例：
#   {
#     "version": 3,
#     "rename": {"users": "members", "openid": "user_openid"},
#     "drop": ["obsolete_field"],
#     "files": {
#       "ws_subs.json": {
#         "keep": ["version", "sessions", "members"],
#         "defaults": {"version": 1, "sessions": {}},
#         "rename": {"owner": "initiator"},
#         "drop": ["tmp"]
#       }
#     }
#   }
#   · rename 递归作用于嵌套层级（含 sessions 里每个会话的字段）
#   · 没写 keep 时，用云端 runtime.json 里该文件的顶层键当最新结构
#   · 删掉的字段不再写入；没写 defaults 的新字段「没有就不写入」
# runtime.json    服务端回写的迁移结果，机器维护、用户只读（避免双向覆盖打架）
# ============================================================
