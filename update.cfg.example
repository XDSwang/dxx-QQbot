# ============================================================
# 公共库根目录的【接口文件模板 / 结构权威】：对接一切接口地址，随代码同提交，进 git。
# 真实值在【私有库根目录】的同名 update.cfg（属于私有库数据，随私有库 git 同步）；
# 启动器只把那份原样拷到公共库根目录，不生成、不改写；本地拷贝不进公共库 git。
#
# run.py 启动第一件事就是读这个文件：缺文件会直接退出、不启动任何服务；
# 文件里的数据后端没配好则只在启动自检里告警，服务照常用本地版本继续运行。
# 公共仓库才是本体（代码 + services.json 服务清单，能放任意服务端跑）；
# 下面这一段配的是【数据后端】—— 授权信息、配置和运行记录本来该放数据库，
# 现在没有数据库，用私有 GIT 仓库的文件代替（读写都走 git 指令）。以后换成数据库 /
# 第三方数据接口，只改这一段，服务代码不用动。
#
# 服务端只需要一条命令：python run.py
# ============================================================

# ---------------- ① 数据后端（最先配） ----------------
# git      = 纯 GIT 读写私有仓库文件（默认，不需要任何密钥 / API / 第三方接口）
#          读：git show <版本>:<文件>，只取用到的那几个文件，不落地整个仓库
#          写：commit-tree + git push；非快进被拒就重拉-重合并（最多 3 轮）
# github / gitee = 旧的 Contents API 后端（可选，默认不用，见 ⑤ 段）
# local    = 本地目录当数据后端（离线测试 / 内网挂载）
# database / http = 以后接数据库 / 第三方数据接口，现在只留位，填了会明确报「未实现」
# ⚠️ 本文件定位是【接口文件】：一切接口地址都在这里对接（当前四个 GIT 源地址），也是数据后端装配入口：
#    就是在这里换 UPDATER_BACKEND，再按 Store 接口在 updater.make_store 注册一个适配器，
#    服务与迁移逻辑都不用动。当前只需要下面几项仓库地址，别的都不用填。
UPDATER_BACKEND = git
# 私有仓库里「所有服务数据」的根目录；每个服务再占一个子目录 <PATH>/<服务名>/
UPDATER_GIT_PATH = services

# ---------------- ①-b 故障转移：主库 3 轮失败切备用源 ----------------
# 备用源就是 ①-c 的 UPDATER_DATA_REPO_BACKUP（同一个私有库的另一份镜像），
# 不需要任何额外配置。主库连续 3 轮拉取 / 回写失败（单轮超 5 秒记
# 「窗口过长」并回到第一步重新拉）才切过去，再走同样的 3 轮；全失败报「数据拉取异常」。
UPDATER_FAILOVER = 1

# ---------------- ①-c 更新判断：GIT 双源拷贝（默认） ----------------
# ⚠️ 下面两行是【GIT 拷贝用的仓库地址】，不是第三方数据接口：判断层只跑 git fetch，
#    不碰任何 API。把占位换成你自己的两个私有库地址即可。
# 每轮用 GIT 指令把两个私有库都拷贝(fetch)下来：
#   · 谁的版本新就用谁，数据读写也跟着切到那个源；
#   · 拷贝下来没有内容变化（HEAD 没变）就是「不用更新」，本轮直接跳过；
#   · 一个源因网络失败，就用拷贝成功的那个继续判断；
#   · 两个都失败才报「数据拉取异常」，本地数据保持原样；
#   · 本地版本比远端新时不回退、不覆盖本地。
# 地址填 HTTPS（本机已存 git 凭证）或 SSH（手机 / 没存凭证的机器）都行，
# 两端不必同一种方式，谁通就用谁。更新判断恒为 GIT 双源拷贝，比版本、无变化不更新。
UPDATER_DATA_REPO = https://github.com/<账号>/<私有库>.git
UPDATER_DATA_REPO_BACKUP = git@gitee.com:<账号>/<私有库>.git
UPDATER_DATA_BRANCH = main
# UPDATER_FAILOVER = 0 可关掉备用源（只拷贝主库）
# 两行都留空时只剩旧配置里的单源兼容路径，正常部署请填上面两行。

# local 后端才生效：目录里按服务名建子目录，各放 config.txt / runtime.json /
# owner.json（schema.json 在公共仓库，私有库不存结构文件）。更新判断走 ①-c 的 GIT 双源拷贝。
UPDATER_LOCAL_DIR = remote

# ---------------- ② 公共仓库本体（代码同步） ----------------
# 首次把整个仓库拷到服务端时若没有 .git，run.py 会用它自动 git init + fetch；
# 之后有【独立的代码版本轮询】：隔几轮双源拷贝一次比版本（约 1 分钟内），
# 私有库完全没动、只 push 了公共库代码，也会触发同步与全服务迁移。
# 两个源都拷贝下来比版本用最新的（本地新则不回退）。
# 一个失败用成功的，两个都失败报「数据拉取异常」。公开仓库拉取不需要凭证。
# 同样换成你自己的公共库地址；公开代码里不写死任何账号 / 仓库名。
UPDATER_CODE_REPO = https://github.com/<账号>/<公共库>.git
UPDATER_CODE_REPO_BACKUP = git@gitee.com:<账号>/<公共库>.git
UPDATER_CODE_BRANCH = main
# 启动时先自动同步一次（把「拷贝来的旧版」拉到最新，必要时自动重启 RUN）
UPDATER_SYNC_ON_START = 1

# ---------------- ③ 本机跑哪些服务 / 本实例是谁 ----------------
# 留空 = services.json 里全部；填名字（逗号分隔）= 这台服务端只跑这几个。
# 同一个公共仓库能放任意服务端跑，各自用自己这份 update.cfg。
SERVICES_ENABLED =

# 同一套代码、不同授权，分别部署到两台服务端时，两个都填上【不同】的值：
# 数据落在 <PATH>/<NAMESPACE>/<服务名>/，不会共用同一份 runtime.json。
# 单服务端 / 单授权保持留空即可（路径与旧版一致）。
UPDATER_DATA_NAMESPACE =
# 认领标记 owner.json 里写谁；检测到目录已被别的实例认领会跳过回写并报异常日志。
UPDATER_INSTANCE_ID = default

# ---------------- ④ 更新行为 ----------------
# 更新判断恒为 ①-c 的 GIT 双源拷贝（比版本、无变化不更新）；
# 代码版本另外独立轮询、降频执行，跟这一行的秒数不是同一件事。
# 同一域名（含子域）连续两次 GIT 访问固定间隔 3~5 秒，状态落盘跨进程共享：
# 一轮的实际耗时可能长于这里写的秒数，属于规则要求，别为提速关掉。
UPDATER_POLL_SECONDS = 10
UPDATER_GIT_PULL = 1
# structure = 以公共模板为结构基准、私有库真实值为覆盖（默认，安全；新字段留空、未知字段保留）
# overwrite = 整份照抄私有库 config.txt 原值（只在想完全跳过模板对账、直接用私有值时用）
UPDATER_CONFIG_MERGE = structure
# 迁移完成后把「最新完整 + 旧数据迁移」结果回写数据后端。
# 同一个授权只有一个网关连接（第二个会把第一个顶掉），正常部署不存在两台机器
# 同时写同一份数据。只有「主备双机故意用同一授权」或「测试机误指生产目录」时
# 才需要设 0；后者现在还有 owner.json 认领兜底，会跳过回写并留下异常日志。
UPDATER_PUSH_RUNTIME = 1

# ============================================================
# 两处职责分开：更新判断走 GIT 双源拷贝，数据才属于私有库
# ------------------------------------------------------------
# 【更新判断 · 默认 GIT 双源拷贝】
# 每轮 fetch 两个私有库接口，比 commit 版本选最新的那份；HEAD 没变就是不用更新。
# 私有库有新提交就会触发下一轮更新，不需要手工改任何发布标记。
# 公共库代码另有独立的版本轮询：只 push 代码、私有库没动，也会触发同步。
#
# 【私有仓库 · 只在真正更新时才读写】
# 读写都走 GIT 指令：git show 只取用到的文件，回写是 commit + git push。
# 私有仓库只存「真实值」；字段结构 / 描述 / 迁移规则在公共仓库（方案 A）。
# services/                      ← UPDATER_GIT_PATH
#   wm-bot/                     ← 服务名（配了 NAMESPACE 则多一层）
#     config.txt                机器人真实配置（只存值；模板 + 描述在公共仓库
#                                wm-bot/python/config.txt，不在这里）
#     runtime.json              服务端回写的迁移结果（机器维护，用户只读）
#     owner.json                首次更新时自动写入的认领标记（机器维护）
#   <以后的服务名>/             同样三份文件，互不干扰
#
# 【公共仓库本体 · 结构权威 · 随代码同提交 · 进 git】
# wm-bot/python/config.txt      配置模板（字段 + 中文描述 + 空值），reconcile 的结构基准
# wm-bot/python/schema.json     运行数据迁移规则（改名 / 删除 / 保留），服务端只读
#   · 服务端以公共模板为基准、私有 config.txt 的真实值为覆盖做「对账（reconcile）」：
#     模板有 + 私有非空 → 用私有值；模板有 + 私有空 → 留空（新字段先空着）；
#     私有有 + 模板无 → 保留（绝不留删除）。只有出现「模板有、私有无」的新字段时，
#     才把带空位的结构回写私有库，等账号本人（网站或 git）填写。
#   · schema.json 示例：
#     {"version": 3, "rename": {"users": "members"},
#      "drop": ["obsolete_field"],
#      "files": {"ws_subs.json": {"keep": ["version", "sessions", "members"],
#                                  "defaults": {"version": 1, "sessions": {}}}}}
#     rename 递归进嵌套层级；删掉的字段不再写入；没写 defaults 的新字段「没有就不写入」。
#     没写 keep 时用云端 runtime.json 里该文件的顶层键当最新结构；顶层写 {} 安全。
# ============================================================
# 启动流程与几个前提
# ------------------------------------------------------------
# · 读 update.cfg → 装配数据后端 → 启动先同步代码 → 需要时自动重启 RUN
#   → 私有库那份 update.cfg 变了也会自动同步到本机并重启重新装配（跟 config.txt 一样）；
#   → 按 services.json 逐个拉起服务 → 轮询私有库与公共库两个版本；
#   有内容更新才拉配置、迁数据、回写；没变化本轮直接跳过。
#   同一轮的私有库拷贝结果由所有服务共用，不重复 fetch。
# · 代码同步同样两个接口都拷贝、比版本用最新的；只停 / 迁 / 启【被触发的服务】；
#   指纹、备份、进程按服务隔离，单实例锁用系统文件锁（手机重启 pid 复用不会误拒）。
# · 一轮更新失败：整次回滚、照常用旧数据启动，该版本指纹记入 failed_signal；
#   只在退避窗口内跳过，窗口过后自动重试（远端没有新提交也能自愈），
#   一个窗口最多 3 轮，用尽后长退避并记异常日志，不无限静默轰炸。
# · 服务崩溃在一个窗口内最多自动拉起 3 次；窗口过期或代码更新后预算清零。
# · 启动自检会在控制台直接列出：数据后端还是模板占位值、缺 services.json、
#   不在 git 仓库且没配 UPDATER_CODE_REPO、没有 git 命令、
#   没配 UPDATER_DATA_REPO / BACKUP、某服务私有目录缺 config。
# · 首次部署不用手填任何东西：私有库根目录的 update.cfg 和各服务真实配置
#   （wm-bot 是 wm-bot/python/data/config.txt）都随私有库 clone 带过来，启动器负责拷；
#   不需要任何密钥 / API 凭证。换地址 / 以后接数据库或第三方接口，只改私有库那一份。
# · GIT 凭证同样是仓库级、不是目录级：多台服务端各跑不同服务时，
#   每台都能读到库里别的项目的文件。要隔离就得给每个项目单独建私有仓库。
# ============================================================
# 多台服务端 / 多个授权 / 其他平台
# ------------------------------------------------------------
# · 一个 AppID 只能维持一条网关连接（官方文档 gateway 的 max_concurrency=1，
#   本项目 identify 写死 shard [0,1]）：同授权开第二个会把第一个顶掉，
#   所以「两台机器同时写同一份 runtime.json」正常部署下不会发生。
#   真遇到（主备双机 / 测试机误指生产目录）：owner.json 认领会跳过回写并报异常；
#   也可以直接把 UPDATER_PUSH_RUNTIME 设 0。
# · 同一台服务端跑两个【不同授权】的同类机器人：机器人代码里 data/ 路径是写死的
#   （config.py / wm.py / ws_monitor.py 等都基于 __file__），两个进程会读同一份
#   data/config.txt、写同一批 ws_*.json。必须各给一份代码目录副本（含自己的 data/），
#   services.json 里两项的 data_dir 不能相同 —— 启动自检会直接把这种配置报出来。
# · 多台服务端：单实例锁是本机 OS 文件锁，进程退出自动释放；跨机不互锁（本来就该各自独立）。
#   每台各放一份本地 update.cfg（从私有库拷来，本机 git 凭证由系统保管），
#   用 SERVICES_ENABLED 决定这台跑哪几个服务；
#   任一边有新提交，所有机器下一轮 GIT 拷贝都会看到，这是「统一发布」的预期行为。
# · 其他平台（Termux / QPython / Linux）：代码零第三方依赖，但 git 是外部命令，
#   Termux 要先 pkg install git；没有 git 时启动自检会提示，GIT 双源拷贝失败会报
#   「数据拉取异常」，服务照常跑、只是不会自动同步。
#   os.execv 自重启、Path 路径、CRLF 都可用。
# · GIT 的 fetch / push / clone / pull 都是地址访问，统一过同域名闸门：
#   间隔 3~5 秒由公共层常量写死，域名归一（api.github.com 与 github.com 同一个 key），
#   状态文件 data/updater_pace.json 跨进程共享，启动器首跑也用同一份。
# ============================================================

# ---------------- ⑤ 以后扩展（当前不生效，别填） ----------------
# 数据库 / 第三方数据接口是【以后】才接的：那时换 UPDATER_BACKEND，再按 Store 接口
# 在 updater.make_store 注册一个适配器即可。判断层（①-c 的 GIT 双源拷贝）与读写层
# 是分开的两套，换后端不用动判断逻辑。当前版本只会明确报「未实现」，不会假装能连。
#
# 旧的 Contents API 后端（github / gitee）代码仍保留作兼容，默认不用；
# 纯 GIT 后端不需要它，别填。
